{
  "name": "alea",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --names web,sync npm:dev:web npm:dev:sync",
    "dev:web": "vite",
    "dev:sync": "node --watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node server/index.ts --client dist/client",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "load-test": "node scripts/loadTest.ts"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "^4.8.0",
    "@hocuspocus/extension-throttle": "^4.8.0",
    "@hocuspocus/provider": "^4.8.0",
    "@hocuspocus/server": "^4.7.0",
    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@mantine/modals": "^9.7.4",
    "@mantine/notifications": "^9.7.4",
    "@tabler/icons": "^3.50.0",
    "@tabler/icons-react": "^3.50.0",
    "compressorjs": "^1.4.0",
    "konva": "^10.9.0",
    "mantine-contextmenu": "^9.4.0",
    "motion": "^14.9.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-konva": "^19.3.2",
    "react-konva-utils": "^2.1.0",
    "react-router": "^8.5.1",
    "simplex-noise": "^4.0.3",
    "sirv": "^3.0.2",
    "use-image": "^1.1.4",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.90.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
