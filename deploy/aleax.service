[Unit]
Description=Aleax
After=network-online.target
Wants=network-online.target

[Service]
User=aleax
Group=aleax
WorkingDirectory=/opt/aleax
Environment=PORT=3000
Environment=DATA_DIR=/var/lib/aleax/data
ExecStart=/usr/bin/node server/index.ts --client dist/client
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/aleax

[Install]
WantedBy=multi-user.target
