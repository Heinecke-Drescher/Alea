[Unit]
Description=Delete Aleax rooms that have not changed for about six months

[Service]
Type=oneshot
User=aleax
Group=aleax
ExecStartPre=/usr/bin/mkdir -p /var/lib/aleax/data/rooms
ExecStart=/usr/bin/find /var/lib/aleax/data/rooms ( -name *.ydoc -mtime +182 -o -name *.tmp -mmin +60 ) -delete
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/aleax
